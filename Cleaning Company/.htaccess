# =====================================================================
#  CLEANING COMPANY WEBSITE  —  Apache configuration
# =====================================================================
#  Works on cPanel, shared hosting, VPS (Apache) and anywhere mod_rewrite
#  is enabled. If your host does not allow some directive, comment that
#  block out — the website still works, only the feature is lost.
#
#  The site runs equally well WITHOUT any rewrite rules:
#  every page is a normal .php file. The rules below only add clean URLs.
# =====================================================================

# ---------------------------------------------------------------- basics
Options -Indexes -MultiViews
DirectoryIndex index.php index.html

# Do not leak the PHP version / server signature
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ------------------------------------------------------------ clean URLs
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ------------------------------------- dynamic sitemap and robots
    # /sitemap.xml and /robots.txt are generated by PHP so they always
    # match the configured domain and the current list of services.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php  [L]
    RewriteRule ^(en|ar)/sitemap\.xml$ sitemap.php [L]
    RewriteRule ^(en|ar)/robots\.txt$  robots.php  [L]

    # -------------------------------------------------- language prefixes
    # /en/            -> /index.php
    RewriteRule ^(en|ar)/?$ index.php [L,QSA]

    # /en/about.php   -> /about.php        (language kept in the URL)
    RewriteRule ^(en|ar)/(.+)\.php$ $2.php [L,QSA]

    # /en/about       -> /about.php       (extension-less, single segment)
    # /en/services/villa-cleaning -> /services/villa-cleaning.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(en|ar)/(.+?)/?$ $2.php [L,QSA]

    # ----------------------------------------------- extension-less URLs
    # /about            -> /about.php
    # /services/villa-cleaning -> /services/villa-cleaning.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^((?:services|areas)/[^/]+|[^/]+?)/?$ $1.php [L,QSA]
</IfModule>

# -------------------------------------------------------- custom 404 page
# Change this path when the site lives in a sub-directory,
# e.g. ErrorDocument 404 /cleaning-company/404.php
ErrorDocument 404 /404.php

# ------------------------------------------------------------ compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# -------------------------------------------------------------- caching
<IfModule mod_expires.c>
    ExpiresActive On
    # Fingerprinted assets can be cached for a long time (asset() adds ?v=).
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    # Pages are dynamic: keep them out of long lived caches.
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|svg|png|jpg|jpeg|gif|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(php|html?)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------- headers back-up
# The PHP bootstrap already sends these; the block below repeats them for
# static files and for hosts where PHP headers are filtered out.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------- file access
# Server-side includes must never be reachable through a URL.
# (Not anchored, so it also works when the site lives in a sub-directory.)
RedirectMatch 404 (?i)/(config|includes|data|tools|lang|deploy)/

# Block dotfiles (.htaccess, .git, .env …) and editor/backup leftovers.
<FilesMatch "(^\.|\.(local\.php|bak|old|orig|swp|sql|log|ini|inc|sh|yml|yaml|lock|json|md|example|conf)$|~$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# robots.txt must stay readable by crawlers.
<Files "robots.txt">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>

# ------------------------------------------------------- mime for WebP
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddCharset UTF-8 .html .css .js .json .xml .svg
</IfModule>

# ------------------------------------------------------------ error pages
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Never rewrite real files or folders (assets, images, actions…).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>
