# =====================================================================
#  CLEANING COMPANY WEBSITE  —  Nginx + PHP-FPM example configuration
# =====================================================================
#  The website works with or without URL rewriting: every page is a
#  normal .php file. The rules below only add the clean URLs and the
#  language prefixes that .htaccess provides on Apache.
#
#  Copy the relevant parts into your server block and adjust:
#    - server_name / root
#    - fastcgi_pass (your PHP-FPM socket)
#
#  Tested layout: Ubuntu/Debian + PHP 8.x FPM.
# =====================================================================

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    # Point this at the folder that contains index.php
    root /var/www/cleaning-company;
    index index.php index.html;

    charset utf-8;
    client_max_body_size 2m;

    # ------------------------------------------------------- security
    # Never expose the server-internal folders through a URL.
    location ~ ^/(config|includes|data|tools|lang|deploy)/ {
        deny all;
        return 404;
    }

    # Block dotfiles (.htaccess, .git, .env ...) and backup leftovers.
    location ~ /\. {
        deny all;
        return 404;
    }
    location ~* \.(bak|old|orig|swp|sql|log|ini|inc|sh|lock|md|example)$ {
        deny all;
        return 404;
    }

    location = /robots.txt {
        allow all;
        try_files $uri =404;
    }

    # ------------------------------------------------------ clean URLs
    # /sitemap.xml and /robots.txt are generated by PHP so they always
    # match the configured domain and the current service list.
    rewrite ^/(en|ar/)sitemap\.xml$ /sitemap.php last;
    rewrite ^/sitemap\.xml$        /sitemap.php last;
    rewrite ^/(en|ar/)robots\.txt$ /robots.php  last;
    rewrite ^/robots\.txt$         /robots.php  last;

    # /en/ -> /index.php
    rewrite ^/(en|ar)/?$ /index.php last;

    # /en/about.php -> /about.php   (language kept in the URL)
    rewrite ^/(en|ar)/(.+)\.php$ /$2.php last;

    # /en/services/villa-cleaning -> /services/villa-cleaning.php
    # /about -> /about.php
    # (only when the request does not match a real file or folder)
    location / {
        try_files $uri $uri/ $uri.php /404.php;
    }

    # ------------------------------------------------------- PHP-FPM
    location ~ \.php$ {
        try_files $uri =404;
        include        fastcgi_params;
        fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param  HTTPS           $https if_not_empty;
        fastcgi_pass   unix:/run/php/php8.2-fpm.sock;   # <-- adjust
        fastcgi_read_timeout 60s;
    }

    # -------------------------------------------------------- caching
    # Fingerprinted assets (asset() adds ?v=...) can be cached for long.
    location ~* \.(css|js|webp|svg|png|jpg|jpeg|gif|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Pages are dynamic: keep them out of long lived caches.
    location ~* \.(html?|php)$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # -------------------------------------------------------- headers
    add_header X-Content-Type-Options "nosniff"        always;
    add_header X-Frame-Options        "SAMEORIGIN"     always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/plain text/css text/xml application/xml
               application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    # ------------------------------------------------------ error page
    error_page 404 /404.php;

    # Block direct access to the error page as a "page".
    location = /404.php {
        internal;
    }
}

# ---------------------------------------------------------------------
#  HTTPS server block — enable once your certificate is installed
#  (for example with certbot: certbot --nginx -d example.com)
# ---------------------------------------------------------------------
# server {
#     listen 443 ssl http2;
#     server_name example.com www.example.com;
#     root /var/www/cleaning-company;
#     index index.php;
#     ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
#     # ... repeat the location blocks above ...
#     add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
# }
